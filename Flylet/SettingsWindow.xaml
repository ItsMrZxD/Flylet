<Window x:Class="Flylet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:Flylet"
        xmlns:media="clr-namespace:Flylet.UI.Fluent.Media"
        xmlns:navigation="clr-namespace:Flylet.Navigation"
        xmlns:utils="clr-namespace:Flylet.Utilities"
        xmlns:resx="clr-namespace:Flylet.Properties"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" Height="760" Width="900"
        ui:WindowHelper.UseModernWindowStyle="True" ui:TitleBar.ExtendViewIntoTitleBar="True"
        media:RevealBrushHelper.TrackThisElement="True"
        Title="{x:Static resx:Strings.SettingsItem}" MinWidth="480" Icon="Assets\Logo.ico">
    <!-- Three tabs, no side menu (0.11 survey: tabs plus a live preview strip on Look) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sits in the title bar area, so it must not catch the clicks that drag the window -->
        <StackPanel Orientation="Horizontal" Height="32" Margin="16,0,0,0" IsHitTestVisible="False">
            <Image Source="/Assets/Images/Flylet_16.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static local:Program.AppName}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{DynamicResource CaptionTextBlockStyle}" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="10,0,0,0" Style="{DynamicResource TabControlPivotStyle}">
            <TabItem Header="{x:Static resx:Strings.Settings_Tab_Look}">
                <navigation:LookTab />
            </TabItem>
            <TabItem Header="{x:Static resx:Strings.Settings_Tab_Flyouts}">
                <navigation:FlyoutsTab />
            </TabItem>
            <TabItem Header="{x:Static resx:Strings.GeneralSettings}">
                <navigation:GeneralTab />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Height="48"
              Background="{DynamicResource NavigationViewExpandedPaneBackground}"
              Visibility="{Binding Source={x:Static local:FlyoutHandler.Instance},
                  Path=UIManager.RestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Info}"
                         VerticalAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Static resx:Strings.Settings_RestartRequired}" />
        </Grid>
    </Grid>
</Window>
