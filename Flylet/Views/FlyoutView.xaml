<UserControl x:Class="Flylet.Views.FlyoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:Flylet"
             xmlns:localui="clr-namespace:Flylet.UI"
             xmlns:controls="clr-namespace:Flylet.Controls"
             xmlns:input="clr-namespace:Flylet.Input"
             xmlns:utils="clr-namespace:Flylet.Utilities"
             xmlns:media="clr-namespace:Flylet.UI.Fluent.Media"
             xmlns:resx="clr-namespace:Flylet.Properties"
             mc:Ignorable="d" media:RevealBrushHelper.TrackThisElement="True"
             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">
    <!--<Border BorderThickness="2"
                CornerRadius="{DynamicResource FlyoutCornerRadius}"
                media:RevealBrushHelper.RevealBrushMode="None"
                Visibility="Collapsed">
        <Border.BorderBrush>
            <LinearGradientBrush>
                <GradientStop Color="Violet" Offset="0" />
                <GradientStop Color="Indigo" Offset="0.1667" />
                <GradientStop Color="Blue" Offset="0.3334" />
                <GradientStop Color="Green" Offset="0.501" />
                <GradientStop Color="Yellow" Offset="0.6668" />
                <GradientStop Color="Orange" Offset="0.8335" />
                <GradientStop Color="Red" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
    </Border>-->
    <Grid>
        <Border Background="#00FFFFFF" input:InputHelper.IsTapEnabled="True"
                input:InputHelper.TappedCommand="{x:Static utils:CommonCommands.CloseFlyoutCommand}"
                input:InputHelper.TappedCommandParameter="{x:Reference Name=TopBarHost}" />
        <controls:DirectableStackPanel x:Name="CardsPanel" x:FieldModifier="private" controls:FlyoutBackgroundLayer.IsPhotoStack="True"
            Spacing="8" Margin="{x:Static localui:UIManager.FlyoutShadowMargin}"
            Direction="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.OnScreenFlyoutContentStackingDirection}">
            <ui:ThemeShadowChrome Depth="{x:Static localui:UIManager.FlyoutShadowDepth}"
                CornerRadius="{DynamicResource FlyoutCornerRadius}"
                Width="{DynamicResource FlyoutWidth}"
                Visibility="{Binding PrimaryContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <controls:FlyoutBackgroundLayer CornerRadius="{DynamicResource FlyoutCornerRadius}" />
                    <StackPanel>
                        <ContentControl x:Name="TopBarHost" x:FieldModifier="private" />
                        <controls:CrossFadeContentControl Content="{Binding PrimaryContent}" />
                    </StackPanel>
                    <Border
                        BorderThickness="{DynamicResource FlyoutBorderThemeThickness}"
                        BorderBrush="{DynamicResource FlyoutBorderThemeBrush}"
                        CornerRadius="{DynamicResource FlyoutCornerRadius}" />
                </Grid>
                <!--<Border Background="{DynamicResource FlyoutBackground}"
                    BorderThickness="{DynamicResource FlyoutBorderThemeThickness}"
                    BorderBrush="{DynamicResource FlyoutBorderThemeBrush}"
                    CornerRadius="{DynamicResource FlyoutCornerRadius}">
                    
                </Border>-->
            </ui:ThemeShadowChrome>
            <!-- The secondary card only ever holds the media card, so it takes the media card's shape -->
            <ui:ThemeShadowChrome Depth="{x:Static localui:UIManager.FlyoutShadowDepth}"
                CornerRadius="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.MediaCardCornerRadius}"
                Width="{DynamicResource FlyoutWidth}"
                Visibility="{Binding SecondaryContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <controls:FlyoutBackgroundLayer CornerRadius="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.MediaCardCornerRadius}" />
                    <controls:CrossFadeContentControl Content="{Binding SecondaryContent}" />
                    <Border
                        BorderThickness="{DynamicResource FlyoutBorderThemeThickness}"
                        BorderBrush="{DynamicResource FlyoutBorderThemeBrush}"
                        CornerRadius="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.MediaCardCornerRadius}" />
                </Grid>
            </ui:ThemeShadowChrome>
            <!-- The note after an update -->
            <ui:ThemeShadowChrome Depth="{x:Static localui:UIManager.FlyoutShadowDepth}"
                CornerRadius="{DynamicResource FlyoutCornerRadius}"
                Width="{DynamicResource FlyoutWidth}"
                Visibility="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.ShowWhatsNewCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <controls:FlyoutBackgroundLayer CornerRadius="{DynamicResource FlyoutCornerRadius}" />
                    <Grid Margin="14,8,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static local:FlyoutHandler.Instance}, Path=UIManager.WhatsNewTitle}" />
                            <ui:HyperlinkButton Padding="0,2" Content="{x:Static resx:Strings.WhatsNew_Link}" Click="WhatsNewLink_Click" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Top" Width="32" Height="32" Padding="0"
                                Background="Transparent" ToolTip="{x:Static resx:Strings.Close}" Click="WhatsNewClose_Click">
                            <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Close}" FontSize="14" />
                        </Button>
                    </Grid>
                    <Border
                        BorderThickness="{DynamicResource FlyoutBorderThemeThickness}"
                        BorderBrush="{DynamicResource FlyoutBorderThemeBrush}"
                        CornerRadius="{DynamicResource FlyoutCornerRadius}" />
                </Grid>
            </ui:ThemeShadowChrome>
        </controls:DirectableStackPanel>
    </Grid>
</UserControl>
