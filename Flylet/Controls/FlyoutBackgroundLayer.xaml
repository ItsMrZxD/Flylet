<UserControl x:Class="Flylet.Controls.FlyoutBackgroundLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:root="clr-namespace:Flylet">
    <!-- Behind every flyout card: the background color, and the user's photo over it when that's on -->
    <Grid x:Name="RootGrid" x:FieldModifier="private" DataContext="{x:Static root:FlyoutHandler.Instance}">
        <Border x:Name="ColorBorder" x:FieldModifier="private" Background="{DynamicResource FlyoutBackground}" />
        <!-- Blurred and darkened so the light text the flyout switches to stays readable -->
        <Grid IsHitTestVisible="False"
              Visibility="{Binding UIManager.IsFlyoutBackgroundImageShown, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border x:Name="PhotoBorder" x:FieldModifier="private" Margin="-70" Opacity="{Binding UIManager.FlyoutBackgroundImageOpacity}">
                <Border.Background>
                    <!-- The code-behind sets the Viewport to where the whole photo lands, so Stretch=Fill doesn't
                         distort it. Past the photo's edges it's mirrored, so the blur never fades into nothing -->
                    <ImageBrush x:Name="PhotoBrush" x:FieldModifier="private"
                                ImageSource="{Binding UIManager.FlyoutBackgroundImage}" Stretch="Fill" TileMode="FlipXY"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="{Binding UIManager.FlyoutBackgroundBlurRadius, Source={x:Static root:FlyoutHandler.Instance}}" KernelType="Gaussian" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
            <Border Background="#000000" Opacity="{Binding UIManager.FlyoutBackgroundImageDimOpacity}" />
        </Grid>
        <!-- "Card shine" (0.13): a bright rim along the top, a softer one at the bottom and a light sheen, so a
             see-through card reads as glass. Drawn once; costs nothing while the flyout sits still -->
        <Grid IsHitTestVisible="False"
              Visibility="{Binding UIManager.ShowCardShine, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#16FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.5" />
                        <GradientStop Color="#08FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border BorderThickness="1" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                        <GradientStop Color="#A0FFFFFF" Offset="0" />
                        <GradientStop Color="#18FFFFFF" Offset="0.45" />
                        <GradientStop Color="#40FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border Margin="1" BorderThickness="1" BorderBrush="#12FFFFFF"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Grid>
</UserControl>
