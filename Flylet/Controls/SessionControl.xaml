<UserControl x:Class="Flylet.Controls.SessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:root="clr-namespace:Flylet"
             xmlns:utils="clr-namespace:Flylet.Utilities"
             xmlns:resx="clr-namespace:Flylet.Properties"
             xmlns:input="clr-namespace:Flylet.Input"
             xmlns:designTime="clr-namespace:Flylet.DesignTime"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance designTime:MockMediaSession}"
             Width="{DynamicResource FlyoutWidth}" VerticalAlignment="Top">
    <!-- Sizes, positions and what's visible come from the media card layout (SessionControl.ApplyLayout) -->
    <Grid x:Name="RootGrid" x:FieldModifier="private">
        <!-- Album art as the card's background, blurred and darkened so the text stays readable -->
        <Grid x:Name="BackgroundArtGrid" x:FieldModifier="private" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Margin="-110">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="{Binding UIManager.AlbumBackgroundBlurRadius, Source={x:Static root:FlyoutHandler.Instance}}" KernelType="Gaussian" RenderingBias="Performance" />
                </Border.Effect>
            </Border>
            <Border Background="#000000" Opacity="0.45" />
        </Grid>

        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TimelineRow" x:FieldModifier="private" Height="66" />
            </Grid.RowDefinitions>

            <!-- Tapping an empty part of the flyout closes it -->
            <Border Grid.RowSpan="2" Background="Transparent"
                    input:InputHelper.IsTapEnabled="True"
                    input:InputHelper.TappedCommand="{x:Static utils:CommonCommands.CloseFlyoutCommand}"
                    input:InputHelper.TappedCommandParameter="{x:Reference Name=ContentGrid}" />

            <Grid x:Name="TopGrid" x:FieldModifier="private" Margin="16,16,16,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="ThumbnailGrid" x:FieldModifier="private" Grid.Column="0" Grid.RowSpan="2"
                      Width="96" Height="96" Margin="0,0,14,0" VerticalAlignment="Center" Cursor="Hand"
                      input:InputHelper.IsTapEnabled="True" input:InputHelper.TappedCommand="{Binding ActivateMediaSourceCommand}">
                    <Border x:Name="ThumbnailPlaceholder" x:FieldModifier="private" CornerRadius="8" Background="#333333" />
                    <Border x:Name="ThumbnailBorder" x:FieldModifier="private" CornerRadius="8">
                        <Border.Background>
                            <ImageBrush x:Name="ThumbnailImageBrush" ImageSource="{Binding Thumbnail}"
                                        Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel x:Name="TextStack" x:FieldModifier="private" Grid.Column="1" VerticalAlignment="Top">
                    <Grid x:Name="AppInfoPanel" x:FieldModifier="private" Height="16" Margin="0,0,0,4" Cursor="Hand"
                          input:InputHelper.IsTapEnabled="True" input:InputHelper.TappedCommand="{Binding ActivateMediaSourceCommand}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding MediaSourceIcon}" Grid.Column="0"
                               Width="16" Height="16" RenderOptions.BitmapScalingMode="Fant" />
                        <TextBlock Text="{Binding MediaSourceName}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Grid.Column="1"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>

                    <Grid x:Name="TextBlockGrid" Cursor="Hand" ClipToBounds="True"
                          input:InputHelper.IsTapEnabled="True" input:InputHelper.TappedCommand="{Binding ActivateMediaSourceCommand}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{DynamicResource BaseTextBlockStyle}" FontSize="15"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                   Text="{Binding Title}" ToolTip="{Binding Title}"
                                   ToolTipService.IsEnabled="{Binding Title, Converter={StaticResource TextToTooltipEnabledConverter}}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="mediaTitleBlockTranslateTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="ArtistTextBlock" x:FieldModifier="private" Grid.Row="1" Height="16"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{Binding Artist}" ToolTip="{Binding Artist}"
                                   ToolTipService.IsEnabled="{Binding Artist, Converter={StaticResource TextToTooltipEnabledConverter}}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="mediaArtistBlockTranslateTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- Under the text on a regular card with full controls, to the right of it otherwise -->
                <Grid x:Name="ControlsGrid" x:FieldModifier="private" Grid.Column="1" Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SplitView x:Name="ControlsSplitView" ClipToBounds="True"
                                  OpenPaneLength="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" PaneBackground="Transparent"
                                  DisplayMode="Inline" IsPaneOpen="False">
                        <ui:SplitView.Pane>
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ShuffleButton" Command="{Binding ChangeShuffleActiveCommand}"
                                              IsChecked="{Binding IsShuffleActive, Mode=OneWay}"
                                              ToolTip="{Binding IsShuffleActive, Converter={StaticResource ShuffleButtonTooltipConverter}}"
                                              Visibility="{Binding IsShuffleEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Width="36" Height="36" Style="{DynamicResource MediaToggleButtonStyle}">
                                    <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Shuffle}" FontSize="16.0" />
                                </ToggleButton>
                                <ToggleButton x:Name="RepeatButton" Command="{Binding ChangeAutoRepeatModeCommand}"
                                              IsChecked="{Binding AutoRepeatMode, Mode=OneWay, Converter={StaticResource RepeatButtonIsCheckedConverter}}"
                                              ToolTip="{Binding AutoRepeatMode, Converter={StaticResource RepeatButtonTooltipConverter}}"
                                              Visibility="{Binding IsRepeatEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Width="36" Height="36" Margin="8,0" Style="{DynamicResource MediaToggleButtonStyle}">
                                    <ui:FontIcon Glyph="{Binding AutoRepeatMode, Converter={StaticResource RepeatButtonGlyphConverter}}" FontSize="16" />
                                </ToggleButton>
                                <Button x:Name="StopButton" Command="{Binding StopCommand}"
                                        ToolTip="{x:Static resx:Strings.SessionControl_Stop}"
                                        Visibility="{Binding IsStopEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Width="36" Height="36" Style="{DynamicResource MediaButtonStyle}">
                                    <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Stop}" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </ui:SplitView.Pane>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousButton" Command="{Binding PreviousTrackCommand}"
                                    ToolTip="{x:Static resx:Strings.SessionControl_Previous}"
                                    Width="36" Height="36" Style="{DynamicResource MediaButtonStyle}">
                                <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Previous}" FontSize="16" />
                            </Button>
                            <Button x:Name="PlayPauseButton" Command="{Binding PlayOrPauseCommand}"
                                    ToolTip="{Binding IsPlaying, Converter={StaticResource PlayPauseButtonTooltipConverter}}"
                                    Width="36" Height="36" Margin="8,0" Style="{DynamicResource HighlightedMediaButtonStyle}">
                                <ui:FontIcon Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseButtonGlyphConverter}}" FontSize="16" />
                            </Button>
                            <Button x:Name="NextButton" Command="{Binding NextTrackCommand}"
                                    ToolTip="{x:Static resx:Strings.SessionControl_Next}"
                                    Width="36" Height="36" Style="{DynamicResource MediaButtonStyle}">
                                <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.Next}" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </ui:SplitView>

                    <!-- The host hides the More button in layouts without room for its pane; the button itself
                         keeps hiding when the source supports none of shuffle, repeat or stop -->
                    <Border x:Name="MoreControlsHost" x:FieldModifier="private" Grid.Column="1">
                        <ToggleButton x:Name="MoreControlsButton"
                                      VerticalAlignment="Center" Width="36" Height="36"
                                      ToolTip="{x:Static resx:Strings.SessionControl_MoreControls}"
                                      Style="{DynamicResource MediaToggleButtonStyle}"
                                      Visibility="{Binding CalculatedMoreControlsButtonVisibility}"
                                      IsChecked="{Binding ElementName=ControlsSplitView, Path=IsPaneOpen}">
                            <ui:FontIcon Glyph="{x:Static utils:CommonGlyphs.More}" FontSize="16" />
                        </ToggleButton>
                    </Border>
                </Grid>
            </Grid>

            <!-- The play button and timeline colors come from the thumbnail (see SessionControl.UpdateAccentColor) -->
            <Grid x:Name="TimelineGrid" Grid.Row="1" Margin="16,0,16,4" VerticalAlignment="Center">
                <!-- Firefox only reports a song's length after the first pause; until a real timeline is known, show an empty line -->
                <Grid Visibility="{Binding IsPlaybackPositionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            Visibility="{Binding IsTimelinePropertiesEnabled, Converter={StaticResource InvertBooleanToVisibilityConverter}}" />
                </Grid>

                <Grid Visibility="{Binding IsTimelinePropertiesEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Visibility="{Binding IsPlaybackPositionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                      IsEnabled="{Binding IsPlaybackPositionEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="{Binding PlaybackPosition, Converter={StaticResource TimeSpanToStringConverter}}" />
                    <Slider Grid.Column="1" IsMoveToPointEnabled="True" Margin="10,0"
                            IsEnabled="{Binding IsPlaybackPositionEnabled}"
                            Minimum="{Binding TimelineStartTime, Mode=OneWay, Converter={StaticResource TimeSpanToNumberConverter}}"
                            Maximum="{Binding TimelineEndTime, Mode=OneWay, Converter={StaticResource TimeSpanToNumberConverter}}"
                            Value="{Binding PlaybackPosition, Converter={StaticResource TimeSpanToNumberConverter}}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="{Binding TimelineEndTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                </Grid>

                <!-- Sessions that report a timeline but can't seek get a plain progress bar instead of the slider -->
                <ui:ProgressBar x:Name="TimelineProgressBar" VerticalAlignment="Center"
                                Visibility="{Binding IsPlaybackPositionEnabled, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                Minimum="{Binding TimelineStartTime, Mode=OneWay, Converter={StaticResource TimeSpanToNumberConverter}}"
                                Maximum="{Binding TimelineEndTime, Mode=OneWay, Converter={StaticResource TimeSpanToNumberConverter}}"
                                Value="{Binding PlaybackPosition, Converter={StaticResource TimeSpanToNumberConverter}}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- The thin timeline runs along the card's bottom edge; RootGrid's clip rounds its ends with the corners -->
        <Grid x:Name="ThinTimelineGrid" x:FieldModifier="private" Height="3" VerticalAlignment="Bottom"
              IsHitTestVisible="False" Visibility="Collapsed">
            <Border Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Border x:Name="ThinTimelineFill" x:FieldModifier="private" HorizontalAlignment="Left"
                    Background="{DynamicResource SystemControlHighlightAccentBrush}">
                <Border.Width>
                    <MultiBinding Converter="{StaticResource TimelineFractionConverter}">
                        <Binding Path="PlaybackPosition" />
                        <Binding Path="TimelineStartTime" />
                        <Binding Path="TimelineEndTime" />
                        <Binding Path="ActualWidth" ElementName="ThinTimelineGrid" />
                    </MultiBinding>
                </Border.Width>
            </Border>
        </Grid>
    </Grid>
</UserControl>
