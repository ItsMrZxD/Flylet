<UserControl x:Class="Flylet.Controls.LockKeysControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:Flylet"
             xmlns:ui="http://schemas.modernwpf.com/2019" xmlns:utils="clr-namespace:Flylet.Utilities"
             mc:Ignorable="d"
             Height="54" d:DesignWidth="354" DataContext="{x:Static root:FlyoutHandler.Instance}">

    <!-- The clean strip testers picked in the 0.11 survey: icon and state, nothing else -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:FontIcon x:Name="LockGlyph" Glyph="{x:Static utils:CommonGlyphs.Lock}" FontSize="20" />
        <TextBlock x:Name="txt" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Style="{DynamicResource BaseTextBlockStyle}" FontSize="15"
                   Margin="14,0,0,0" Text="Lock key is on" />
    </StackPanel>

</UserControl>
