<UserControl x:Class="Flylet.Navigation.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Flylet" xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:Flylet.Controls"
             xmlns:toolkit="http://schemas.modernwpf.com/toolkit"
             xmlns:utils="clr-namespace:Flylet.Utilities" xmlns:helpers="clr-namespace:Flylet.Helpers"
             xmlns:resx="clr-namespace:Flylet.Properties"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{x:Static local:FlyoutHandler.Instance}">
    <!-- Settings > General: startup, language, which flyout to use, tray icon, reset, about -->
    <controls:ScrollViewerEx VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10" MaxWidth="760" HorizontalAlignment="Left">
            <GroupBox Header="{x:Static resx:Strings.Settings_Behavior}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_RunAtStartup}" IsOn="{Binding RunAtStartup}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <ComboBox ItemsSource="{x:Static helpers:LocalizationHelper.SupportedLanguages}"
                              SelectedItem="{Binding Path=(helpers:LocalizationHelper.CurrentLanguage)}"
                              MinWidth="240" HorizontalAlignment="Left">
                        <ui:ControlHelper.Header>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="4"
                                                 ToolTip="{x:Static resx:Strings.Settings_LanguageDescription}">
                                <TextBlock Text="{x:Static resx:Strings.Settings_Language}" />
                                <ui:FontIcon FontSize="14" Glyph="{x:Static utils:CommonGlyphs.Info}" />
                            </ui:SimpleStackPanel>
                        </ui:ControlHelper.Header>
                    </ComboBox>
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_TrayIconEnabled}"
                                     IsOn="{Binding UIManager.TrayIconEnabled}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_UseColoredTrayIcon}"
                                     IsOn="{Binding UIManager.UseColoredTrayIcon}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}"
                                     Visibility="{Binding UIManager.TrayIconEnabled,
                                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_DefaultFlyout}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:RadioButtons x:Name="DefaultFlyoutSelector"
                        Header="{x:Static resx:Strings.Settings_DefaultFlyoutDescription}"
                        ItemTemplate="{StaticResource LocalizedEnumItemTemplate}"
                        ItemsSource="{toolkit:EnumValues Type=local:DefaultFlyout}"
                        SelectedItem="{Binding DefaultFlyout}" />
                    <ui:SimpleStackPanel Spacing="10"
                                         Visibility="{Binding ElementName=DefaultFlyoutSelector, Path=SelectedIndex,
                                            Converter={StaticResource IndexToVisibilityConverter}}">
                        <TextBlock Margin="0,5" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                   TextWrapping="Wrap" Text="{x:Static resx:Strings.Settings_DefaultFlyoutWarningMessage}" />
                        <Button Content="{x:Static resx:Strings.ExitItemDescription}"
                                Command="{x:Static utils:CommonCommands.ExitAppCommand}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_Additional}">
                <Button Style="{DynamicResource ButtonRevealStyle}"
                        Content="{x:Static resx:Strings.Settings_ResetToDefaults}"
                        Command="{x:Static utils:CommonCommands.ResetAppDataCommand}" />
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.About}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="14">
                        <Image Source="/Assets/Images/Flylet_128.png" Height="64" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Text="{x:Static local:Program.AppName}" />
                            <TextBlock>
                                <Run Text="{x:Static resx:Strings.About_Version}" />
                                <Bold>
                                    <Run Text="{x:Static local:Program.AppVersion}" />
                                </Bold>
                            </TextBlock>
                        </StackPanel>
                    </ui:SimpleStackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{x:Static resx:Strings.About_AppDescription}" />
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{x:Static resx:Strings.About_FileABug}" />
                    <Button Style="{DynamicResource ButtonRevealStyle}"
                            Content="{x:Static resx:Strings.About_RateAndReview}" Click="RateAndReviewButton_Click" />
                    <ui:HyperlinkButton Content="{x:Static resx:Strings.About_GitHub}"
                                        NavigateUri="https://github.com/ItsMrZxD/Flylet" />
                    <ui:HyperlinkButton Content="{x:Static resx:Strings.About_OpenNewIssue}"
                                        NavigateUri="https://github.com/ItsMrZxD/Flylet/issues/new/choose" />
                    <ui:HyperlinkButton Content="{x:Static resx:Strings.About_Contributors}"
                                        NavigateUri="https://github.com/ItsMrZxD/Flylet/graphs/contributors" />
                    <ui:HyperlinkButton Content="{x:Static resx:Strings.About_Dependencies}"
                                        NavigateUri="https://github.com/ItsMrZxD/Flylet/network/dependencies" />
                    <ui:HyperlinkButton Content="{x:Static resx:Strings.About_BasedOn}"
                                        NavigateUri="https://github.com/ModernFlyouts-Community/ModernFlyouts" />
                </ui:SimpleStackPanel>
            </GroupBox>
        </StackPanel>
    </controls:ScrollViewerEx>
</UserControl>
