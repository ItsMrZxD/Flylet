<UserControl x:Class="Flylet.Navigation.FlyoutsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Flylet" xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:toolkitControls="http://schemas.modernwpf.com/toolkit/controls"
             xmlns:toolkit="http://schemas.modernwpf.com/toolkit"
             xmlns:controls="clr-namespace:Flylet.Controls"
             xmlns:media="clr-namespace:Flylet.UI.Media"
             xmlns:utils="clr-namespace:Flylet.Utilities"
             xmlns:resx="clr-namespace:Flylet.Properties"
             xmlns:coreui="clr-namespace:Flylet.Core.UI;assembly=Flylet.Core"
             xmlns:display="clr-namespace:Flylet.Core.Display;assembly=Flylet.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" DataContext="{x:Static local:FlyoutHandler.Instance}">
    <!-- Settings > Flyouts: which flyouts Flylet replaces and their options, where they show up, how long they stay -->
    <controls:ScrollViewerEx VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,10" MaxWidth="760" HorizontalAlignment="Left">
            <GroupBox Header="{x:Static resx:Strings.Settings_Modules_Audio}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_EnableModule_Audio}"
                                     IsOn="{Binding AudioFlyoutHelper.IsEnabled}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <ui:SimpleStackPanel Spacing="10" IsEnabled="{Binding AudioFlyoutHelper.IsEnabled, Mode=OneWay}">
                        <ui:ToggleSwitch Header="{x:Static resx:Strings.AudioFlyoutHelper_ShowGSMTCInVolumeFlyout}"
                                         IsOn="{Binding AudioFlyoutHelper.ShowGSMTCInVolumeFlyout}"
                                         OnContent="{x:Static resx:Strings.Settings_On}"
                                         OffContent="{x:Static resx:Strings.Settings_Off}" />
                        <ui:ToggleSwitch Header="{x:Static resx:Strings.AudioFlyoutHelper_ShowVolumeControlInGSMTCFlyout}"
                                         IsOn="{Binding AudioFlyoutHelper.ShowVolumeControlInGSMTCFlyout}"
                                         OnContent="{x:Static resx:Strings.Settings_On}"
                                         OffContent="{x:Static resx:Strings.Settings_Off}" />
                        <ui:RadioButtons x:Name="orientationCmbBox" x:FieldModifier="private"
                                         Header="{x:Static resx:Strings.AudioFlyoutHelper_SessionsPanelOrientation}"
                                         ItemTemplate="{StaticResource LocalizedEnumItemTemplate}"
                                         ItemsSource="{toolkit:EnumValues Type=Orientation}"
                                         SelectedItem="{Binding UIManager.SessionsPanelOrientation}" />
                        <ui:NumberBox Header="{x:Static resx:Strings.AudioFlyoutHelper_MaxVerticalSessionControlsCount}" MinWidth="240"
                                      HorizontalAlignment="Left" Minimum="1" Maximum="10" SmallChange="1" LargeChange="2"
                                      SpinButtonPlacementMode="Inline" Value="{Binding UIManager.MaxVerticalSessionControlsCount}"
                                      Visibility="{Binding ElementName=orientationCmbBox, Path=SelectedIndex,
                                        Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_Modules_Brightness}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_EnableModule_Brightness}"
                                     IsOn="{Binding BrightnessFlyoutHelper.IsEnabled}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <ItemsControl ItemsSource="{Binding Source={x:Static display:BrightnessManager.Instance}, Path=BrightnessControllers}"
                                  IsEnabled="{Binding BrightnessFlyoutHelper.IsEnabled, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ui:SimpleStackPanel Orientation="Vertical" Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type display:BrightnessController}">
                                <Grid HorizontalAlignment="Left" Width="300">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="10"
                                                         Grid.ColumnSpan="3">
                                        <TextBlock Text="{Binding AssociatedDisplayMonitor.Index}" />
                                        <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding AssociatedDisplayMonitor.DisplayName}" />
                                    </ui:SimpleStackPanel>
                                    <Grid Grid.Row="1">
                                        <ui:FontIcon Grid.Column="0" FontSize="16">
                                            <ui:FontIcon.Glyph>
                                                <Binding Path="Brightness">
                                                    <Binding.Converter>
                                                        <toolkit:DoubleToObjectConverter GreaterThan="50"
                                                            TrueValue="{x:Static utils:CommonGlyphs.Brightness}"
                                                            FalseValue="{x:Static utils:CommonGlyphs.LowerBrightness}" />
                                                    </Binding.Converter>
                                                </Binding>
                                            </ui:FontIcon.Glyph>
                                        </ui:FontIcon>
                                    </Grid>

                                    <Slider Maximum="{Binding Maximum}"
                                            Minimum="{Binding Minimum}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" Margin="8,0"
                                            SmallChange="0.01" Value="{Binding Brightness}"
                                            IsMoveToPointEnabled="True" />

                                    <TextBlock Grid.Column="2" Grid.Row="1" HorizontalAlignment="Center" Margin="6"
                                               Style="{DynamicResource SubtitleTextBlockStyle}"
                                               Text="{Binding Brightness, StringFormat={}{0:#0}}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_Modules_LockKeys}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_EnableModule_LockKeys}"
                                     IsOn="{Binding LockKeysFlyoutHelper.IsEnabled}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <ui:SimpleStackPanel Spacing="10" IsEnabled="{Binding LockKeysFlyoutHelper.IsEnabled, Mode=OneWay}">
                        <TextBlock Text="{x:Static resx:Strings.LockKeysFlyoutHelper_SelectKeyDescription}" />
                        <CheckBox Content="{x:Static resx:Strings.LockKeysFlyoutHelper_CapsLock}" IsChecked="{Binding LockKeysFlyoutHelper.CapsLockEnabled}" />
                        <CheckBox Content="{x:Static resx:Strings.LockKeysFlyoutHelper_NumLock}" IsChecked="{Binding LockKeysFlyoutHelper.NumLockEnabled}" />
                        <CheckBox Content="{x:Static resx:Strings.LockKeysFlyoutHelper_ScrollLock}" IsChecked="{Binding LockKeysFlyoutHelper.ScrollLockEnabled}" />
                        <CheckBox Content="{x:Static resx:Strings.LockKeysFlyoutHelper_Insert}" IsChecked="{Binding LockKeysFlyoutHelper.InsertEnabled}" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_Modules_Airplane}">
                <StackPanel>
                    <ui:ToggleSwitch Header="{x:Static resx:Strings.Settings_EnableModule_Airplane}"
                                     IsOn="{Binding AirplaneModeFlyoutHelper.IsEnabled}"
                                     IsEnabled="{Binding AirplaneModeFlyoutHelper.HasRadios}"
                                     OnContent="{x:Static resx:Strings.Settings_On}"
                                     OffContent="{x:Static resx:Strings.Settings_Off}" />
                    <TextBlock Text="{x:Static resx:Strings.Settings_Airplane_NoRadios}"
                               Visibility="{Binding AirplaneModeFlyoutHelper.HasRadios, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_FlyoutPlacement}">
                <ui:SimpleStackPanel Spacing="10">
                    <ui:SimpleStackPanel Spacing="5">
                        <TextBlock Text="{x:Static resx:Strings.Settings_Display}" Style="{DynamicResource BaseTextBlockStyle}" />
                        <TextBlock Text="{x:Static resx:Strings.Settings_DisplayDescription}" TextWrapping="Wrap" />
                        <controls:DisplayMonitorPicker
                            PreferredDisplayMonitor="{Binding OnScreenFlyoutPreferredMonitor, Mode=TwoWay}" />
                    </ui:SimpleStackPanel>

                    <ui:RadioButtons x:Name="PlacementModeSelector"
                        Header="{x:Static resx:Strings.Settings_FlyoutPlacementMode}"
                        ItemTemplate="{StaticResource LocalizedEnumItemTemplate}"
                        ItemsSource="{toolkit:EnumValues Type=coreui:FlyoutWindowPlacementMode}"
                        SelectedItem="{Binding UIManager.OnScreenFlyoutWindowPlacementMode}" />
                    <ui:SimpleStackPanel
                        Spacing="10"
                        Visibility="{Binding ElementName=PlacementModeSelector, Path=SelectedIndex,
                            Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                        <controls:FlyoutAlignmentPicker Alignment="{Binding UIManager.OnScreenFlyoutWindowAlignment}" />
                    </ui:SimpleStackPanel>
                    <ui:SimpleStackPanel
                        Spacing="5"
                        Visibility="{Binding ElementName=PlacementModeSelector, Path=SelectedIndex,
                            Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock Text="{x:Static resx:Strings.Settings_FlyoutDefaultPosition}" />
                        <toolkitControls:SimpleWrapPanel
                            Orientation="Horizontal"
                            HorizontalSpacing="10"
                            VerticalSpacing="10">
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="X:" VerticalAlignment="Center" />
                                <ui:NumberBox
                                    Width="240"
                                    SpinButtonPlacementMode="Inline"
                                    Maximum="{x:Static media:BindablePoint.MaxXValue}"
                                    Value="{Binding DefaultFlyoutPosition.X}" />
                            </ui:SimpleStackPanel>
                            <ui:SimpleStackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="Y:" VerticalAlignment="Center" />
                                <ui:NumberBox
                                    Width="240"
                                    SpinButtonPlacementMode="Inline"
                                    Maximum="{x:Static media:BindablePoint.MaxYValue}"
                                    Value="{Binding DefaultFlyoutPosition.Y}" />
                            </ui:SimpleStackPanel>
                        </toolkitControls:SimpleWrapPanel>
                    </ui:SimpleStackPanel>
                    <!-- Moves a dragged flyout back to its spot; this used to be a button on the flyout's top bar -->
                    <Button Style="{DynamicResource ButtonRevealStyle}"
                            Content="{x:Static resx:Strings.Settings_AlignFlyout}"
                            Command="{x:Static utils:CommonCommands.AlignOnScreenFlyoutToDefaultPosition}" />

                    <ComboBox
                        ui:ControlHelper.Header="{x:Static resx:Strings.Settings_FlyoutExpandDirection}"
                        Width="240" HorizontalAlignment="Left"
                        ItemTemplate="{StaticResource LocalizedEnumItemTemplate}"
                        ItemsSource="{toolkit:EnumValues Type=coreui:FlyoutWindowExpandDirection}"
                        SelectedItem="{Binding UIManager.OnScreenFlyoutWindowExpandDirection}"/>
                    <ui:RadioButtons
                        ui:ControlHelper.Header="{x:Static resx:Strings.Settings_FlyoutContentStackingDirection}"
                        ItemTemplate="{StaticResource LocalizedEnumItemTemplate}"
                        ItemsSource="{toolkit:EnumValues Type=controls:StackingDirection}"
                        SelectedItem="{Binding UIManager.OnScreenFlyoutContentStackingDirection}"/>
                </ui:SimpleStackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static resx:Strings.Settings_FlyoutHideAfter}">
                <!-- In seconds, as the survey asked; stored in milliseconds like before -->
                <ui:SimpleStackPanel Spacing="10" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Slider Minimum="1" Maximum="10" TickFrequency="0.25" IsSnapToTickEnabled="True"
                            Width="240" IsMoveToPointEnabled="True"
                            Value="{Binding UIManager.FlyoutTimeout, Converter={StaticResource MillisecondsToSecondsConverter}}" />
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}" VerticalAlignment="Center">
                        <Run Text="{Binding UIManager.FlyoutTimeout, Converter={StaticResource MillisecondsToSecondsConverter}, StringFormat={}{0:0.##} s}" />
                    </TextBlock>
                </ui:SimpleStackPanel>
            </GroupBox>
        </StackPanel>
    </controls:ScrollViewerEx>
</UserControl>
